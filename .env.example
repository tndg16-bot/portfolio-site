# Google Forms Configuration
# Replace with your actual Google Forms action URL and entry IDs
NEXT_PUBLIC_GOOGLE_FORMS_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID/formResponse

# Entry IDs for Booking Form fields
NEXT_PUBLIC_ENTRY_NAME=entry.1234567890
NEXT_PUBLIC_ENTRY_EMAIL=entry.1234567891
NEXT_PUBLIC_ENTRY_OCCUPATION=entry.1234567892
NEXT_PUBLIC_ENTRY_GOAL=entry.1234567893
NEXT_PUBLIC_ENTRY_MOTIVATION=entry.1234567894
NEXT_PUBLIC_ENTRY_DATE1=entry.1234567895
NEXT_PUBLIC_ENTRY_DATE2=entry.1234567896
NEXT_PUBLIC_ENTRY_MESSAGE=entry.1234567897

# Resend (Newsletter) Configuration
# Get your API key from https://resend.com/api-keys
# 1. Sign up at https://resend.com
# 2. Add and verify your domain
# 3. Get API key from https://resend.com/api-keys
# 4. Update the 'from' address in src/app/api/subscribe/route.ts to match your verified domain
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin email for notifications (optional)
ADMIN_EMAIL=your-email@example.com

# Giscus (Comments) Configuration
# Configure Giscus at https://giscus.app
# 1. Install Giscus app to your GitHub repository
# 2. Enter repository details
# 3. Copy the generated IDs and update src/components/GiscusComments.tsx:
#    - repo: "username/repo-name"
#    - repoId: "R_kgDO..."
#    - categoryId: "DIC_kwDO..."

# Supabase Configuration (Newsletter & Auth)
# Get your credentials from https://supabase.com/dashboard
# 1. Create a new project at https://supabase.com/dashboard/new
# 2. Go to Project Settings > API to get credentials
# 3. Run the migration in supabase/migrations/001_newsletter_system.sql
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Admin Authentication
# Set a strong password to protect admin panel
# Change this immediately after first login!
ADMIN_PASSWORD=change-this-password-in-production
ADMIN_JWT_SECRET=change-this-secret-key-in-production

# Google Analytics 4
# Get your Measurement ID from https://analytics.google.com/
# 1. Create a GA4 property and data stream
# 2. Copy the Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# GitHub API Configuration
# Get your GitHub token from https://github.com/settings/tokens
# 1. Go to GitHub Settings > Developer settings > Personal access tokens > Tokens (classic)
# 2. Generate new token with 'repo' scope
# 3. Add the token to your .env.local file (NOT to this example file)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sentry Configuration (Error Monitoring)
# Get your credentials from https://sentry.io/
# 1. Create a Sentry account at https://sentry.io/signup/
# 2. Create a new Next.js project
# 3. Copy the DSN from Project Settings > Client Keys (DSN)
# 4. Get Auth Token from Account Settings > Auth Tokens
SENTRY_DSN=https://xxxxxxx@o1234.ingest.sentry.io/123456
SENTRY_AUTH_TOKEN=sntrys_xxxxxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxx@o1234.ingest.sentry.io/123456
SENTRY_ORG=your-org-name
SENTRY_PROJECT=portfolio-site
